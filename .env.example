# Settings for the Hacker News tests, with their default values.
# The tests use this file unless you create your own `.env` (git-ignored):
#   cp .env.example .env    then edit `.env`
# CI uses these values. None of them is secret: never put passwords or tokens in either file.
# A real environment variable overrides both files, e.g. `PAGE_PAUSE_MS=2000 npm test`.

# Site under test
BASE_URL=https://news.ycombinator.com

# Milliseconds spent reading (scrolling down) each page before clicking "More"
PAGE_PAUSE_MS=10000
# How many times a rate-limited page (HTTP 429/503) is reloaded before the test fails
RATE_LIMIT_RETRIES=3
# Milliseconds to wait before each of those reloads
RATE_LIMIT_RETRY_DELAY_MS=10000
# If you raise these a lot, also raise the test `timeout` in playwright.config.ts.
