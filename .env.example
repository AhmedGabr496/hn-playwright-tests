# Copy this file to `.env` and fill in the values: cp .env.example .env
# `.env` is git-ignored. In CI these values come from GitHub repository Variables / Secrets.

# Base URL of the application under test (required)
BASE_URL=https://news.ycombinator.com

# Minimum milliseconds between page loads (optional, default 0).
# CI uses 30000 to honour Hacker News' robots.txt "Crawl-delay: 30" on shared runner IPs.
# NAVIGATION_DELAY_MS=0
