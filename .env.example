# Copy this file to `.env` and fill in the values: cp .env.example .env
# `.env` is git-ignored. In CI these values come from GitHub repository Variables / Secrets.

# Base URL of the application under test (required)
BASE_URL=https://news.ycombinator.com

# Pacing for Hacker News' rate limit (optional; the values shown are the defaults).
# If you raise them a lot, also raise the test `timeout` in playwright.config.ts.
# Milliseconds spent reading (scrolling down) each page before clicking "More"
# PAGE_PAUSE_MS=10000
# How many times a rate-limited page (HTTP 429/503) is reloaded before the test fails
# RATE_LIMIT_RETRIES=3
# Milliseconds to wait before each of those reloads
# RATE_LIMIT_RETRY_DELAY_MS=10000
